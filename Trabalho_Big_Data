        "# Casos oficiais preservados na ordem original; complementos têm semente fixa.\n",
        "# Chaves distintas permitem justificar e validar o pior caso exatamente.\n",
        "def medir(busca, arr, alvos):\n",
        "    def lote():\n",
        "        for alvo in alvos:\n",
        "            busca(arr, alvo)\n",
        "    lote()  # aquecimento fora da medição\n",
        "    tempos = np.asarray(timeit.repeat(lote, repeat=REPETICOES, number=1)) / len(alvos)\n",
        "    comparacoes = [busca(arr, alvo)[1] for alvo in alvos]\n",
        "    return float(np.median(tempos)), float(np.mean(comparacoes)), float(np.std(tempos))\n",
        "\n",
        "\n",
        "def executar_experimentos():\n",
        "    rng = np.random.default_rng(SEED)\n",
        "    resultados = []\n",
        "    for n in N_VALUES:\n",
        "        arr_desordenado = casos_oficiais[n] if n in casos_oficiais else rng.permutation(n).astype(np.int64) * 2\n",
        "        np.sort(arr_desordenado)  # aquecimento\n",
        "        tempos_sort = timeit.repeat(lambda: np.sort(arr_desordenado), repeat=5, number=1)\n",
        "        tempo_sort = float(np.median(tempos_sort))\n",
        "        arr_ordenado = np.sort(arr_desordenado)\n",
        "        # Amostra uniforme, sem reposição, de consultas bem-sucedidas.\n",
        "        alvos_medios = [int(x) for x in rng.choice(arr_ordenado, size=min(AMOSTRAS, n), replace=False)]\n",
        "        alvos_piores = {\n",
