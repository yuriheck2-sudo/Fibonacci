        "        linha = {'N': n, 'Origem': 'Oficial fornecido' if n in casos_oficiais else 'Sintético complementar', 'Amostras': len(alvos_medios), 'Tempo Ordenacao': tempo_sort}\n",
        "        for nome, busca in [('Seq', busca_sequencial), ('Jump', jump_search), ('Bin', busca_binaria)]:\n",
        "            # Sequencial não paga ordenação; as outras buscam na cópia ordenada.\n",
        "            arr = arr_desordenado if nome == 'Seq' else arr_ordenado\n",
        "            for caso, alvos in [('Pior', [alvos_piores[nome]] * 10), ('Médio', alvos_medios)]:\n",
        "                tempo, comp, dispersao = medir(busca, arr, alvos)\n",
        "                linha[f'Tempo {nome} ({caso})'] = tempo\n",
        "                linha[f'Comp {nome} ({caso})'] = comp\n",
        "                linha[f'DP tempo {nome} ({caso})'] = dispersao\n",
