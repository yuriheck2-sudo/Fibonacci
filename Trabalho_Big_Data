        "        assert linha['Comp Bin (Pior)'] == 2 * n.bit_length()\n",
        "        salto = math.isqrt(n)\n",
        "        limite_jump = max(k + min(salto, n - (k-1)*salto) for k in range(1, math.ceil(n/salto)+1))\n",
        "        assert linha['Comp Jump (Pior)'] == limite_jump\n",
        "        resultados.append(linha)\n",
        "        print(f'N={n:,}: concluído; {len(alvos_medios)} alvos no caso médio.', flush=True)\n",
        "    return pd.DataFrame(resultados)\n",
