        "def busca_sequencial(arr, target):\n",
        "    num_comp = 0\n",
        "    for i in range(len(arr)):\n",
        "        num_comp += 1\n",
        "        if arr[i] == target:\n",
        "            return i, num_comp\n",
        "    return -1, num_comp\n",
        "\n",
        "\n",
        "def jump_search(arr, target):\n",
        "    # Pré-condição: arr em ordem crescente. Aceita vetor vazio.\n",
        "    n = len(arr)\n",
        "    salto = max(1, math.isqrt(n))\n",
        "    inicio, fim, num_comp = 0, salto, 0\n",
        "    while inicio < n:\n",
        "        num_comp += 1\n",
        "        if arr[min(fim, n) - 1] >= target:\n",
        "            break\n",
        "        inicio = fim\n",
        "        fim += salto\n",
        "    for i in range(inicio, min(fim, n)):\n",
        "        num_comp += 1\n",
        "        if arr[i] == target:\n",
        "            return i, num_comp\n",
        "    return -1, num_comp\n",
        "\n",
        "\n",
        "def busca_binaria(arr, target):\n",
        "    # Pré-condição: arr em ordem crescente.\n",
        "    low, high, num_comp = 0, len(arr) - 1, 0\n",
        "    while low <= high:\n",
        "        mid = (low + high) // 2\n",
        "        num_comp += 1\n",
        "        if arr[mid] == target:\n",
        "            return mid, num_comp\n",
        "        num_comp += 1\n",
        "        if arr[mid] < target:\n",
        "            low = mid + 1\n",
        "        else:\n",
        "            high = mid - 1\n",
        "    return -1, num_comp\n",
        "\n",
        "\n",
        "def alvo_pior_jump(arr):\n",
        "    # Em chaves distintas, no bloco k o máximo é k + tamanho do bloco.\n",
        "    n = len(arr)\n",
        "    if not n:\n",
        "        return -1\n",
        "    salto = max(1, math.isqrt(n))\n",
        "    fins = list(range(salto, n + 1, salto))\n",
        "    if not fins or fins[-1] != n:\n",
        "        fins.append(n)\n",
        "    fim = max(fins, key=lambda e: math.ceil(e / salto) + min(salto, e - ((e - 1) // salto) * salto))\n",
        "    return int(arr[fim - 1])\n",
        "\n",
        "\n",
        "# Testes próprios de correção (não substituem os casos oficiais).\n",
        "for n in range(65):\n",
        "    a = np.arange(n, dtype=np.int64) * 2\n",
        "    for alvo in range(-1, 2 * n + 1):\n",
        "        for busca in (busca_sequencial, jump_search, busca_binaria):\n",
        "            indice, comparacoes = busca(a, alvo)\n",
        "            assert comparacoes >= 0\n",
        "            assert (indice == -1) == (alvo not in a)\n",
        "            if indice != -1:\n",
        "                assert a[indice] == alvo\n",
        "    if n:\n",
        "        assert jump_search(a, alvo_pior_jump(a))[1] == max(jump_search(a, t)[1] for t in range(-1, 2*n+1))\n",
        "        assert busca_binaria(a, int(a[-1]) + 1)[1] == 2 * n.bit_length()\n",
        "for a in ([1, 1, 1], [0, 0, 2, 2, 5]):\n",
