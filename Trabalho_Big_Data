        "            assert (indice == -1) == (alvo not in a)\n",
        "            if indice != -1:\n",
        "                assert a[indice] == alvo\n",
        "print(\"Testes próprios aprovados: vazio, presentes, ausentes, duplicatas e pior caso.\")"
